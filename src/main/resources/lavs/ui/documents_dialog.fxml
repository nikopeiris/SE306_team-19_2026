<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="760.0" spacing="14.0" styleClass="customer-popup, customer-dialog" stylesheets="@customer.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.CustomerDocumentsDialog">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label styleClass="section-title" text="Documents" />
      <Label fx:id="hintLabel" styleClass="hint-label" wrapText="true" />

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="360.0" styleClass="form-scroll" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="14.0">
               <children>
                  <Label fx:id="emptyLabel" styleClass="hint-label" text="No documents added yet. Use the + tile to add one." />
                  <FlowPane fx:id="listContainer" hgap="14.0" vgap="14.0">
                     <children>
                        <Button fx:id="addTile" mnemonicParsing="false" onAction="#handleAdd" prefHeight="76.0" prefWidth="220.0" styleClass="add-tile" text="+" />
                     </children>
                  </FlowPane>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <Label fx:id="statusLabel" maxWidth="Infinity" styleClass="hint-label" wrapText="true" />
   </children>
</VBox>
