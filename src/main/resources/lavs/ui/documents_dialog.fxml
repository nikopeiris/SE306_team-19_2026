<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="660.0" spacing="14.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.CustomerDocumentsDialog">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Documents" />
      <Label fx:id="hintLabel" style="-fx-text-fill: #726e97;" wrapText="true" />

      <ScrollPane fitToWidth="true" prefViewportHeight="300.0" style="-fx-background-color: transparent;">
         <content>
            <VBox spacing="8.0">
               <children>
                  <Label fx:id="emptyLabel" style="-fx-text-fill: #726e97;" text="No documents added yet." />
                  <VBox fx:id="listContainer" spacing="8.0" />
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <Label fx:id="statusLabel" maxWidth="Infinity" wrapText="true" />

      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleAdd" prefHeight="36.0" style="-fx-background-color: #011936; -fx-text-fill: white;" text="Add Document" />
            <Region HBox.hgrow="ALWAYS" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleClose" prefHeight="36.0" text="Close" />
         </children>
      </HBox>
   </children>
</VBox>
