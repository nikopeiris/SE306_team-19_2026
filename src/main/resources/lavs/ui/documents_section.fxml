<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.DocumentsSectionController">
   <children>
      <Label fx:id="headingLabel" styleClass="section-title" text="Documents" />
      <Label fx:id="hintLabel" styleClass="hint-label" text="Save the customer first to add documents." wrapText="true" />
      <Label fx:id="emptyLabel" managed="false" styleClass="hint-label" text="No documents added yet. Use the + tile to add one." visible="false" />
      <FlowPane fx:id="listContainer" hgap="14.0" managed="false" vgap="14.0" visible="false">
         <children>
            <Button fx:id="addTile" mnemonicParsing="false" onAction="#handleAdd" prefHeight="76.0" prefWidth="220.0" styleClass="add-tile" text="+" />
         </children>
      </FlowPane>
      <Label fx:id="statusLabel" maxWidth="Infinity" styleClass="hint-label" wrapText="true" />
   </children>
</VBox>
