<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.AddDocumentDialog">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Button mnemonicParsing="false" onAction="#handleChooseFile" text="Choose file..." />

      <GridPane hgap="12.0" vgap="10.0">
         <children>
            <Label text="Type *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="typeField" prefWidth="260.0" promptText="e.g. Passport" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="File name *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="fileNameField" prefWidth="260.0" promptText="e.g. passport.pdf" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="File type" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="fileTypeField" prefWidth="260.0" promptText="optional, e.g. pdf" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Size (bytes) *" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="sizeField" prefWidth="260.0" promptText="size in bytes" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>

      <Label style="-fx-text-fill: #726e97;" text="* required. Only the details are stored, not the file itself." />
      <Label fx:id="errorLabel" maxWidth="380.0" style="-fx-text-fill: #b00020;" wrapText="true" />

      <HBox spacing="10.0">
         <children>
            <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false" onAction="#handleSave" text="Save" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleCancel" text="Cancel" />
         </children>
      </HBox>
   </children>
</VBox>
