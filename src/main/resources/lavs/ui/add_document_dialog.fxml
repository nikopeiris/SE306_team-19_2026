<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="480.0" spacing="16.0" styleClass="customer-popup, customer-dialog, customer-dialog-frame" stylesheets="@customer.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.AddDocumentDialog">
   <padding>
      <Insets bottom="24.0" left="28.0" right="28.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label fx:id="titleLabel" styleClass="section-title" text="Add document" />
            <Region HBox.hgrow="ALWAYS" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleCancel" prefHeight="36.0" prefWidth="36.0" styleClass="close-button" text="✕" />
         </children>
      </HBox>

      <Button fx:id="chooseFileButton" mnemonicParsing="false" onAction="#handleChooseFile" prefHeight="44.0" prefWidth="170.0" styleClass="button-secondary" text="Choose file" />

      <VBox spacing="6.0">
         <children>
            <HBox spacing="4.0">
               <children>
                  <Label styleClass="field-label" text="Type" />
                  <Label styleClass="required-mark" text="*" />
               </children>
            </HBox>
            <TextField fx:id="typeField" maxWidth="Infinity" prefHeight="44.0" promptText="e.g. Passport" />
         </children>
      </VBox>

      <VBox spacing="6.0">
         <children>
            <HBox spacing="4.0">
               <children>
                  <Label styleClass="field-label" text="File name" />
                  <Label styleClass="required-mark" text="*" />
               </children>
            </HBox>
            <TextField fx:id="fileNameField" maxWidth="Infinity" prefHeight="44.0" promptText="e.g. passport.pdf" />
         </children>
      </VBox>

      <VBox fx:id="fileTypeBox" spacing="6.0">
         <children>
            <Label styleClass="field-label" text="File type" />
            <TextField fx:id="fileTypeField" maxWidth="Infinity" prefHeight="44.0" promptText="optional, e.g. pdf" />
         </children>
      </VBox>

      <VBox fx:id="sizeBox" spacing="6.0">
         <children>
            <HBox spacing="4.0">
               <children>
                  <Label styleClass="field-label" text="Size (bytes)" />
                  <Label styleClass="required-mark" text="*" />
               </children>
            </HBox>
            <TextField fx:id="sizeField" maxWidth="Infinity" prefHeight="44.0" promptText="size in bytes" />
         </children>
      </VBox>

      <Label fx:id="noteLabel" styleClass="hint-label" text="* required. Only the details are stored, not the file itself." />
      <Label fx:id="errorLabel" maxWidth="Infinity" styleClass="error-label" wrapText="true" />

      <HBox fx:id="actionRow" alignment="CENTER_RIGHT" spacing="12.0">
         <children>
            <Button fx:id="deleteButton" managed="false" mnemonicParsing="false" onAction="#handleDelete" prefHeight="44.0" prefWidth="120.0" styleClass="button-danger" text="Delete" visible="false" />
            <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false" onAction="#handleSave" prefHeight="44.0" prefWidth="120.0" styleClass="button-primary" text="Save" />
         </children>
      </HBox>

      <VBox fx:id="confirmBox" managed="false" spacing="12.0" visible="false">
         <children>
            <Label styleClass="confirm-message" text="Delete this document? It is removed from the customer straight away." wrapText="true" />
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleKeepDocument" prefHeight="44.0" prefWidth="120.0" styleClass="button-outline" text="Keep" />
                  <Button fx:id="confirmDeleteButton" mnemonicParsing="false" onAction="#handleConfirmDelete" prefHeight="44.0" prefWidth="120.0" styleClass="button-danger" text="Delete" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
