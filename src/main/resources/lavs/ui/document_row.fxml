<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContentDisplay?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<Button contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false" onAction="#handleOpen" prefHeight="76.0" prefWidth="220.0" styleClass="document-tile" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.DocumentRowController">
   <graphic>
      <VBox alignment="CENTER_LEFT" prefWidth="186.0" spacing="4.0">
         <children>
            <Label fx:id="typeLabel" maxWidth="Infinity" styleClass="document-type" />
            <Label fx:id="nameLabel" maxWidth="Infinity" styleClass="document-name" />
         </children>
      </VBox>
   </graphic>
</Button>
