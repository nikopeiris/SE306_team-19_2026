<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane prefHeight="595.0" prefWidth="1057.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.LoanTabController">
   <children>
      <Text layoutX="14.0" layoutY="30.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Loans" />
      <TableView fx:id="loansTable" layoutX="14.0" layoutY="45.0" prefHeight="180.0" prefWidth="1030.0">
        <columns>
          <TableColumn fx:id="loanSelectColumn" prefWidth="50.0" text="Select" />
          <TableColumn fx:id="loanIdColumn" prefWidth="100.0" text="Loan ID" />
          <TableColumn fx:id="loanTypeColumn" prefWidth="150.0" text="Type" />
          <TableColumn fx:id="loanAmountColumn" prefWidth="150.0" text="Amount" />
          <TableColumn fx:id="loanDateCreatedColumn" prefWidth="200.0" text="Date Created" />
        </columns>
      </TableView>
      <Button mnemonicParsing="false" onAction="#handleAddLoan" layoutX="14.0" layoutY="235.0" text="Add Loan" />

      <Button fx:id="loanBackButton" layoutX="805.0" layoutY="539.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="110.0" text="Back" />
      <Button fx:id="saveButton" defaultButton="true" layoutX="925.0" layoutY="539.0" mnemonicParsing="false" onAction="#handleSave" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #011936;" text="Save Customer" textFill="WHITE" />

      <!-- Add Loan Overlay Pane -->
      <Pane fx:id="addLoanPane" layoutX="100.0" layoutY="50.0" prefHeight="450.0" prefWidth="850.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-radius: 10;" visible="false" managed="false">
         <children>
            <Text layoutX="20.0" layoutY="30.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Add New Loan">
               <font><Font name="System Bold" size="16.0" /></font>
            </Text>
            <Button fx:id="cancelLoanButton" layoutX="600.0" layoutY="400.0" mnemonicParsing="false" onAction="#handleCancelLoan" text="Cancel" />
            <Button fx:id="submitLoanButton" layoutX="700.0" layoutY="400.0" mnemonicParsing="false" onAction="#handleSubmitLoan" text="Submit Loan" />
         </children>
      </Pane>
   </children>
</Pane>