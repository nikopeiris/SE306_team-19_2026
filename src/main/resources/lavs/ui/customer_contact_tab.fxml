<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="595.0" prefWidth="1057.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.ContactInfoController">
   <children>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="12.0">
               <padding>
                  <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
               </padding>
               <children>
                  <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Addresses" />
                  <VBox fx:id="addressListContainer" spacing="6.0" />
                  <HBox><children><Button mnemonicParsing="false" onAction="#handleAddAddress" text="Add Address" /></children></HBox>

                  <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Phone Numbers">
                     <VBox.margin><Insets top="12.0" /></VBox.margin>
                  </Label>
                  <VBox fx:id="phoneNumberListContainer" spacing="6.0" />
                  <HBox><children><Button mnemonicParsing="false" onAction="#handleAddNumber" text="Add Phone Number" /></children></HBox>

                  <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Email Addresses">
                     <VBox.margin><Insets top="12.0" /></VBox.margin>
                  </Label>
                  <VBox fx:id="emailListContainer" spacing="6.0" />
                  <HBox><children><Button mnemonicParsing="false" onAction="#handleAddEmail" text="Add Email Address" /></children></HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <padding>
            <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="36.0" prefWidth="110.0" text="Back">
               <cursor><Cursor fx:constant="HAND" /></cursor>
            </Button>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleSave" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: #011936;" text="Save Customer" textFill="WHITE">
               <cursor><Cursor fx:constant="HAND" /></cursor>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
