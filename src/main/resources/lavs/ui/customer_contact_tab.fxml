<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane prefHeight="595.0" prefWidth="1057.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.ContactInfoController">
   <children>
      <VBox layoutX="20.0" layoutY="20.0" prefWidth="900.0" spacing="12.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Addresses">
               <font><Font name="System Bold" size="14.0" /></font>
            </Text>
            <VBox fx:id="addressListContainer" spacing="6.0" />
            <Button mnemonicParsing="false" onAction="#handleAddAddress" text="Add Address" />

            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Phone Numbers">
               <font><Font name="System Bold" size="14.0" /></font>
            </Text>
            <VBox fx:id="phoneNumberListContainer" spacing="6.0" />
            <Button mnemonicParsing="false" onAction="#handleAddNumber" text="Add Phone Number" />

            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Email Addresses">
               <font><Font name="System Bold" size="14.0" /></font>
            </Text>
            <VBox fx:id="emailListContainer" spacing="6.0" />
            <Button mnemonicParsing="false" onAction="#handleAddEmail" text="Add Email Address" />
         </children>
      </VBox>

      <Button fx:id="contactBackButton" layoutX="805.0" layoutY="539.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="110.0" text="Back" />
      <Button fx:id="contactNextButton" defaultButton="true" layoutX="925.0" layoutY="539.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #011936;" text="Next" textFill="WHITE" />
   </children>
</Pane>