<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane fx:id="dashboardRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" styleClass="dashboard-root" style="-fx-background-color: #011936;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.DashboardController">
<stylesheets>
<URL value="@dashboard.css" />
</stylesheets>
<children>

<!-- ============================ HEADER ============================ -->

<!-- Logo: same banner as the login screen (navy banner, white italic wordmark, yellow dot on the "i", orange swoosh) -->
<Pane fx:id="logoContent" layoutX="-7.0" layoutY="18.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="62.0" prefWidth="366.0">
<children>
<Rectangle fx:id="logoBackground" fill="#011936" height="62.0" layoutX="-14.0" width="314.0" />

<!-- Orange swoosh along the bottom left, curving down at its right end -->
<SVGPath fx:id="logoSwoosh" content="M0 51.5 H184 C193 51.5 198 55.5 201 62 H0 Z" fill="#D2522F" scaleX="2.0" />

<!-- Wordmark, split so the "i" can carry its own yellow dot -->
<HBox fx:id="logoWordmark" layoutX="34.0" layoutY="14.0" spacing="0.0">
<children>
<Text fx:id="logoTitleStart" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Countryw">
<font>
<Font name="Roboto Black Italic" size="28.0" />
</font>
</Text>
<StackPane fx:id="logoI">
<children>
<!-- dotless i (U+0131) so the yellow dot replaces the normal one -->
<Text fx:id="logoIStem" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="ı">
<font>
<Font name="Roboto Black Italic" size="28.0" />
</font>
</Text>
<Circle fx:id="logoDot" fill="#FFE600" radius="3.3" translateX="3.0" StackPane.alignment="TOP_CENTER">
<StackPane.margin>
<Insets top="3.0" />
</StackPane.margin>
</Circle>
</children>
</StackPane>
<Text fx:id="logoTitleEnd" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="de Bank">
<font>
<Font name="Roboto Black Italic" size="28.0" />
</font>
</Text>
</children>
</HBox>
</children>
<!-- rounds the banner's corners (and trims the swoosh to match) -->
<clip>
<Rectangle arcHeight="12.0" arcWidth="12.0" height="62.0" width="300.0" />
</clip>
</Pane>

<Button fx:id="signOutButton" layoutX="1060.0" layoutY="32.0" mnemonicParsing="false" onAction="#handleSignOut" prefHeight="34.0" prefWidth="100.0" styleClass="btn-ghost" text="Sign out" />

<!-- ============================ TOP STRIP ============================ -->

<!-- Customers card -->
<Pane layoutX="40.0" layoutY="104.0" prefHeight="400.0" prefWidth="480.0" styleClass="card">
<children>
<Label layoutX="24.0" layoutY="19.0" styleClass="card-title" text="Customers" />

<Button fx:id="reloadCustomersButton" layoutX="236.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleReloadCustomers" prefHeight="32.0" prefWidth="76.0" styleClass="btn-secondary" text="Reload" />

<Button fx:id="addCustomerButton" layoutX="320.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleAddCustomer" prefHeight="32.0" prefWidth="136.0" styleClass="btn-primary" text="+ New Customer" />

<TextField fx:id="customerSearchField" layoutX="24.0" layoutY="60.0" prefHeight="40.0" prefWidth="432.0" promptText="Search by name, customer ID or email" styleClass="search-field" />
<SVGPath fill="TRANSPARENT" content="M1.5 6.5 A5 5 0 1 1 11.5 6.5 A5 5 0 1 1 1.5 6.5 Z M10.2 10.2 L14.5 14.5" layoutX="38.0" layoutY="72.0" mouseTransparent="true" styleClass="search-icon" />

<!-- Column headers (widths match NAME_WIDTH / ID_WIDTH in DashboardController) -->
<HBox fx:id="customerListHeader" layoutX="24.0" layoutY="114.0" prefHeight="16.0" prefWidth="432.0" spacing="10.0">
<padding>
<Insets left="10.0" right="10.0" />
</padding>
<children>
<Label maxWidth="140.0" minWidth="140.0" prefWidth="140.0" styleClass="col-header" text="NAME" />
<Label maxWidth="95.0" minWidth="95.0" prefWidth="95.0" styleClass="col-header" text="CUSTOMER ID" />
<Label styleClass="col-header" text="EMAIL" />
</children>
</HBox>

<!-- Scrollable customer list (all customers by default, filtered as you type) -->
<ListView fx:id="customerListView" layoutX="24.0" layoutY="134.0" prefHeight="242.0" prefWidth="432.0" styleClass="modern-list" />
</children>
</Pane>

<!-- Loans card -->
<Pane layoutX="540.0" layoutY="104.0" prefHeight="400.0" prefWidth="620.0" styleClass="card">
<children>
<Label layoutX="24.0" layoutY="19.0" styleClass="card-title" text="Loans" />

<Label fx:id="loanStatusLabel" alignment="CENTER_RIGHT" layoutX="224.0" layoutY="23.0" prefWidth="372.0" styleClass="muted" />

<TextField fx:id="loanSearchField" layoutX="24.0" layoutY="60.0" prefHeight="40.0" prefWidth="236.0" promptText="Search by Loan ID" styleClass="search-field" />
<SVGPath fill="TRANSPARENT" content="M1.5 6.5 A5 5 0 1 1 11.5 6.5 A5 5 0 1 1 1.5 6.5 Z M10.2 10.2 L14.5 14.5" layoutX="38.0" layoutY="72.0" mouseTransparent="true" styleClass="search-icon" />

<ComboBox fx:id="loanStatusFilter" layoutX="272.0" layoutY="60.0" prefHeight="40.0" prefWidth="200.0" promptText="All statuses" styleClass="modern-combo" />

<TableView fx:id="loanTable" layoutX="24.0" layoutY="112.0" prefHeight="228.0" prefWidth="572.0" styleClass="modern-table">
<columns>
<TableColumn fx:id="loanIdColumn" prefWidth="100.0" text="LOAN ID" />
<TableColumn fx:id="loanCustomerColumn" prefWidth="150.0" text="CUSTOMER" />
<TableColumn fx:id="loanPrincipalColumn" prefWidth="120.0" text="PRINCIPAL" />
<TableColumn fx:id="loanDateColumn" prefWidth="100.0" text="START DATE" />
<TableColumn fx:id="loanStatusColumn" prefWidth="102.0" text="STATUS" />
</columns>
<columnResizePolicy>
<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
</columnResizePolicy>
</TableView>

<Label layoutX="24.0" layoutY="356.0" styleClass="muted" text="Double-click a loan to open its summary" />

<Button fx:id="changeStatusButton" layoutX="446.0" layoutY="348.0" mnemonicParsing="false" onAction="#handleChangeStatus" prefHeight="32.0" prefWidth="150.0" styleClass="btn-dark" text="Change Status" />
</children>
</Pane>

<!-- ============================ BOTTOM STRIP ============================ -->

<!-- Recent Customers -->
<Pane layoutX="40.0" layoutY="524.0" prefHeight="236.0" prefWidth="300.0" styleClass="card">
<children>
<Label layoutX="24.0" layoutY="18.0" styleClass="card-title-small" text="Recent Customers" />
<ListView fx:id="recentCustomersList" layoutX="24.0" layoutY="56.0" prefHeight="160.0" prefWidth="252.0" styleClass="modern-list" />
</children>
</Pane>

<!-- Recent Loans -->
<Pane layoutX="360.0" layoutY="524.0" prefHeight="236.0" prefWidth="300.0" styleClass="card">
<children>
<Label layoutX="24.0" layoutY="18.0" styleClass="card-title-small" text="Recent Loans" />
<ListView fx:id="recentLoansList" layoutX="24.0" layoutY="56.0" prefHeight="160.0" prefWidth="252.0" styleClass="modern-list" />
</children>
</Pane>

<!-- Loan Summary: bubbles sized by each status's share of all loans, then a verification progress bar -->
<Pane layoutX="680.0" layoutY="524.0" prefHeight="236.0" prefWidth="480.0" styleClass="card">
<children>
<Label layoutX="24.0" layoutY="18.0" styleClass="card-title-small" text="Loan Summary" />
<Label fx:id="summaryTotalsLabel" alignment="CENTER_RIGHT" layoutX="224.0" layoutY="21.0" prefWidth="232.0" styleClass="muted" text="-" />

<!-- filled in by DashboardController -->
<Pane fx:id="summaryBubblePane" layoutX="24.0" layoutY="52.0" prefHeight="120.0" prefWidth="432.0" />

<Label layoutX="24.0" layoutY="184.0" styleClass="col-header" text="VERIFICATION PROGRESS" />
<Label fx:id="summaryProgressLabel" alignment="CENTER_RIGHT" layoutX="296.0" layoutY="184.0" prefWidth="160.0" styleClass="col-header" text="-" />
<ProgressBar fx:id="summaryProgressBar" layoutX="24.0" layoutY="206.0" minHeight="10.0" prefHeight="10.0" prefWidth="432.0" progress="0.0" styleClass="summary-progress" />
</children>
</Pane>

</children>
</Pane>
