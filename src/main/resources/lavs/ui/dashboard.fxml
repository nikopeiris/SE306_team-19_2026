<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #011936;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.DashboardController">
<children>
<Circle fill="#f18f01" layoutX="-106.0" layoutY="320.0" radius="496.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />

<!-- Logo: same banner as the login screen (navy banner, white italic wordmark, yellow dot on the "i", orange swoosh) -->
<Pane fx:id="logoContent" layoutX="24.0" layoutY="14.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="62.0" prefWidth="300.0">
<children>
<Rectangle fx:id="logoBackground" fill="#3B3A7D" height="62.0" width="300.0" />

<!-- Orange swoosh along the bottom left, curving down at its right end -->
<SVGPath fx:id="logoSwoosh" content="M0 51.5 H184 C193 51.5 198 55.5 201 62 H0 Z" fill="#D2522F" />

<!-- Wordmark, split so the "i" can carry its own yellow dot -->
<HBox fx:id="logoWordmark" layoutX="15.0" layoutY="12.0" spacing="0.0">
<children>
<Text fx:id="logoTitleStart" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Countryw">
<font>
<Font name="Roboto Black Italic" size="28.0" />
</font>
</Text>
<StackPane fx:id="logoI">
<children>
<!-- dotless i (U+0131) so the yellow dot replaces the normal one -->
<Text fx:id="logoIStem" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="&#305;">
<font>
<Font name="Roboto Black Italic" size="28.0" />
</font>
</Text>
<Circle fx:id="logoDot" fill="#FFE600" radius="3.3" translateX="3.0" StackPane.alignment="TOP_CENTER">
<StackPane.margin>
<Insets top="3.0" />
</StackPane.margin>
</Circle>
</children>
</StackPane>
<Text fx:id="logoTitleEnd" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="de Bank">
<font>
<Font name="Roboto Black Italic" size="28.0" />
</font>
</Text>
</children>
</HBox>
</children>
<!-- rounds the banner's corners (and trims the swoosh to match) -->
<clip>
<Rectangle arcHeight="12.0" arcWidth="12.0" height="62.0" width="300.0" />
</clip>
</Pane>

<Button fx:id="signOutButton" layoutX="1096.0" layoutY="20.0" mnemonicParsing="false" onAction="#handleSignOut" style="-fx-background-color: transparent;" text="Sign out" textFill="WHITE">
<font>
<Font name="Roboto Bold" size="16.0" />
</font>
<cursor>
<Cursor fx:constant="HAND" />
</cursor>
</Button>
<Rectangle arcHeight="25.0" arcWidth="25.0" fill="#f8fff4" height="240.0" layoutX="182.0" layoutY="116.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="854.0" />
<TextField fx:id="customerSearchField" layoutX="215.0" layoutY="160.0" prefHeight="36.0" prefWidth="787.0" promptText="Search by name, customer ID or email" />

<!-- Column headers (widths match NAME_WIDTH / ID_WIDTH in DashboardController) -->
<HBox fx:id="customerListHeader" layoutX="215.0" layoutY="202.0" prefHeight="18.0" prefWidth="787.0">
<padding>
<Insets left="12.0" right="12.0" />
</padding>
<children>
<Label minWidth="290.0" prefWidth="290.0" maxWidth="290.0" text="NAME" textFill="#726e97">
<font>
<Font name="Roboto Bold" size="11.0" />
</font>
</Label>
<Label minWidth="170.0" prefWidth="170.0" maxWidth="170.0" text="CUSTOMER ID" textFill="#726e97">
<font>
<Font name="Roboto Bold" size="11.0" />
</font>
</Label>
<Label text="PRIMARY EMAIL" textFill="#726e97">
<font>
<Font name="Roboto Bold" size="11.0" />
</font>
</Label>
</children>
</HBox>

<!-- Scrollable customer list (all customers by default, filtered as you type) -->
<ListView fx:id="customerListView" layoutX="215.0" layoutY="222.0" prefHeight="120.0" prefWidth="787.0" style="-fx-background-color: white; -fx-border-color: #d9d9d9; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 0;" />
<Button fx:id="addCustomerButton" defaultButton="true" layoutX="870.0" layoutY="122.0" mnemonicParsing="false" prefHeight="28.0" prefWidth="134.0" style="-fx-background-color: #726e97;" text="Add New Customer" textFill="WHITE">
<cursor>
<Cursor fx:constant="HAND" />
</cursor>
<font>
<Font name="Roboto Bold" size="13.0" />
</font>
</Button>
<Rectangle arcHeight="25.0" arcWidth="25.0" fill="#f8fff4" height="344.0" layoutX="184.0" layoutY="390.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="0.0" width="571.0" />
<TableView layoutX="185.0" layoutY="443.0" prefHeight="278.0" prefWidth="567.0">
<columns>
<TableColumn prefWidth="222.1530303955078" text="Name" />
<TableColumn prefWidth="170.84690856933594" text="Amount" />
<TableColumn prefWidth="195.7835693359375" text="Date Created" />
</columns>
</TableView>
<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Text" />
<Text fill="#011936" layoutX="202.0" layoutY="424.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Recent Loans">
<font>
<Font name="Roboto Bold" size="15.0" />
</font>
</Text>
<Rectangle arcHeight="25.0" arcWidth="25.0" fill="#f8fff4" height="350.0" layoutX="796.0" layoutY="385.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="0.0" width="241.0" />
<Text fill="#011936" layoutX="818.0" layoutY="423.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Search for Loan">
<font>
<Font name="Roboto Bold" size="15.0" />
</font>
</Text>
<Text fill="#011936" layoutX="224.0" layoutY="146.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Search for Customer">
<font>
<Font name="Roboto Bold" size="15.0" />
</font>
</Text>
<TextField layoutX="812.0" layoutY="448.0" promptText="Type Loan ID" />
<Text layoutX="813.0" layoutY="495.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Loan Status" />
</children>
</Pane>
