<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<!--
  Palette:  Prussian Blue #011936 | Mint Cream #F8FFF4 | Vintage Lavender #726E97
            Deep Crimson  #931621 | Carrot Orange #F18F01        Font: Roboto

  Layout (1200 x 800): 40px outer margins, 20px gutters.
    Header           y 18-80
    Top strip        y 104-504   Customers (480 wide) | Loans (620 wide)
    Bottom strip     y 524-760   Recent Customers | Recent Loans | Loan Summary (360 wide each)
-->
<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #011936;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.DashboardController">
<children>

<!-- ============================ HEADER ============================ -->

<!-- Logo: same banner as the login screen (navy banner, white italic wordmark, yellow dot on the "i", orange swoosh) -->
<Pane fx:id="logoContent" layoutX="-7.0" layoutY="18.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="62.0" prefWidth="366.0">
<children>
<Rectangle fx:id="logoBackground" fill="#011936" height="62.0" layoutX="-14.0" width="314.0" />

<!-- Orange swoosh along the bottom left, curving down at its right end -->
<SVGPath fx:id="logoSwoosh" content="M0 51.5 H184 C193 51.5 198 55.5 201 62 H0 Z" fill="#D2522F" scaleX="2.0" />

<!-- Wordmark, split so the "i" can carry its own yellow dot -->
<HBox fx:id="logoWordmark" layoutX="34.0" layoutY="14.0" spacing="0.0">
<children>
<Text fx:id="logoTitleStart" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Countryw">
<font>
<Font name="Roboto Black Italic" size="28.0" />
</font>
</Text>
<StackPane fx:id="logoI">
<children>
<!-- dotless i (U+0131) so the yellow dot replaces the normal one -->
<Text fx:id="logoIStem" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="ı">
<font>
<Font name="Roboto Black Italic" size="28.0" />
</font>
</Text>
<Circle fx:id="logoDot" fill="#FFE600" radius="3.3" translateX="3.0" StackPane.alignment="TOP_CENTER">
<StackPane.margin>
<Insets top="3.0" />
</StackPane.margin>
</Circle>
</children>
</StackPane>
<Text fx:id="logoTitleEnd" fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="de Bank">
<font>
<Font name="Roboto Black Italic" size="28.0" />
</font>
</Text>
</children>
</HBox>
</children>
<!-- rounds the banner's corners (and trims the swoosh to match) -->
<clip>
<Rectangle arcHeight="12.0" arcWidth="12.0" height="62.0" width="300.0" />
</clip>
</Pane>

<Button fx:id="signOutButton" layoutX="1060.0" layoutY="32.0" mnemonicParsing="false" onAction="#handleSignOut" prefHeight="34.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-border-color: #F8FFF4; -fx-border-radius: 8; -fx-background-radius: 8;" text="Sign out" textFill="#F8FFF4">
<font>
<Font name="Roboto Bold" size="14.0" />
</font>
<cursor>
<Cursor fx:constant="HAND" />
</cursor>
</Button>

<!-- ============================ TOP STRIP ============================ -->

<!-- Customers card -->
<Pane layoutX="40.0" layoutY="104.0" prefHeight="400.0" prefWidth="480.0" style="-fx-background-color: #F8FFF4; -fx-background-radius: 16;">
<children>
<Label layoutX="20.0" layoutY="18.0" text="Customers" textFill="#011936">
<font>
<Font name="Roboto Bold" size="18.0" />
</font>
</Label>

<Button fx:id="reloadCustomersButton" layoutX="236.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleReloadCustomers" prefHeight="30.0" prefWidth="84.0" style="-fx-background-color: transparent; -fx-border-color: #726E97; -fx-border-radius: 8; -fx-background-radius: 8;" text="Reload" textFill="#726E97">
<font>
<Font name="Roboto Bold" size="13.0" />
</font>
<cursor>
<Cursor fx:constant="HAND" />
</cursor>
</Button>

<Button fx:id="addCustomerButton" layoutX="330.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleAddCustomer" prefHeight="30.0" prefWidth="130.0" style="-fx-background-color: #F18F01; -fx-background-radius: 8;" text="+ New Customer" textFill="#011936">
<font>
<Font name="Roboto Bold" size="13.0" />
</font>
<cursor>
<Cursor fx:constant="HAND" />
</cursor>
</Button>

<TextField fx:id="customerSearchField" layoutX="20.0" layoutY="58.0" prefHeight="36.0" prefWidth="440.0" promptText="Search by name, customer ID or email" style="-fx-background-color: white; -fx-border-color: #726E97; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #011936; -fx-prompt-text-fill: #726E97; -fx-font-family: 'Roboto'; -fx-font-size: 13; -fx-focus-color: #F18F01; -fx-faint-focus-color: transparent;" />

<!-- Column headers (widths match NAME_WIDTH / ID_WIDTH in DashboardController) -->
<HBox fx:id="customerListHeader" layoutX="20.0" layoutY="106.0" prefHeight="16.0" prefWidth="440.0">
<padding>
<Insets left="10.0" right="25.0" />
</padding>
<children>
<Label maxWidth="140.0" minWidth="140.0" prefWidth="140.0" text="NAME" textFill="#726E97">
<font>
<Font name="Roboto Bold" size="11.0" />
</font>
</Label>
<Label maxWidth="100.0" minWidth="100.0" prefWidth="100.0" text="CUSTOMER ID" textFill="#726E97">
<font>
<Font name="Roboto Bold" size="11.0" />
</font>
</Label>
<Label text="EMAIL" textFill="#726E97">
<font>
<Font name="Roboto Bold" size="11.0" />
</font>
</Label>
</children>
</HBox>

<!-- Scrollable customer list (all customers by default, filtered as you type) -->
<ListView fx:id="customerListView" layoutX="20.0" layoutY="126.0" prefHeight="254.0" prefWidth="440.0" style="-fx-background-color: white; -fx-border-color: #D6D4E3; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;" />
</children>
</Pane>

<!-- Loans card -->
<Pane layoutX="540.0" layoutY="104.0" prefHeight="400.0" prefWidth="620.0" style="-fx-background-color: #F8FFF4; -fx-background-radius: 16;">
<children>
<Label layoutX="20.0" layoutY="18.0" text="Loans" textFill="#011936">
<font>
<Font name="Roboto Bold" size="18.0" />
</font>
</Label>

<Label fx:id="loanStatusLabel" alignment="CENTER_RIGHT" layoutX="240.0" layoutY="22.0" prefWidth="360.0" textFill="#726E97">
<font>
<Font name="Roboto" size="12.0" />
</font>
</Label>

<TextField fx:id="loanSearchField" layoutX="20.0" layoutY="58.0" prefHeight="36.0" prefWidth="230.0" promptText="Search by Loan ID" style="-fx-background-color: white; -fx-border-color: #726E97; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #011936; -fx-prompt-text-fill: #726E97; -fx-font-family: 'Roboto'; -fx-font-size: 13; -fx-focus-color: #F18F01; -fx-faint-focus-color: transparent;" />

<ComboBox fx:id="loanStatusFilter" layoutX="262.0" layoutY="58.0" prefHeight="36.0" prefWidth="190.0" promptText="All statuses" style="-fx-background-color: white; -fx-border-color: #726E97; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Roboto'; -fx-font-size: 13; -fx-focus-color: #F18F01; -fx-faint-focus-color: transparent;" />

<TableView fx:id="loanTable" layoutX="20.0" layoutY="110.0" prefHeight="232.0" prefWidth="580.0" style="-fx-background-color: white; -fx-border-color: #D6D4E3; -fx-border-radius: 8; -fx-background-radius: 8; -fx-selection-bar: #726E97; -fx-selection-bar-non-focused: #B9B7CF; -fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-font-family: 'Roboto'; -fx-font-size: 12;">
<columns>
<TableColumn fx:id="loanIdColumn" prefWidth="100.0" text="Loan ID" />
<TableColumn fx:id="loanCustomerColumn" prefWidth="160.0" text="Customer" />
<TableColumn fx:id="loanPrincipalColumn" prefWidth="130.0" text="Principal" />
<TableColumn fx:id="loanDateColumn" prefWidth="100.0" text="Date" />
<TableColumn fx:id="loanStatusColumn" prefWidth="90.0" text="Status" />
</columns>
<columnResizePolicy>
<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
</columnResizePolicy>
</TableView>

<Label layoutX="20.0" layoutY="360.0" text="Double-click a loan to open its summary" textFill="#726E97">
<font>
<Font name="Roboto" size="12.0" />
</font>
</Label>

<Button fx:id="changeStatusButton" layoutX="440.0" layoutY="352.0" mnemonicParsing="false" onAction="#handleChangeStatus" prefHeight="32.0" prefWidth="160.0" style="-fx-background-color: #011936; -fx-background-radius: 8; -fx-opacity: 1;" text="Change Status" textFill="#F8FFF4">
<font>
<Font name="Roboto Bold" size="13.0" />
</font>
<cursor>
<Cursor fx:constant="HAND" />
</cursor>
</Button>
</children>
</Pane>

<!-- ============================ BOTTOM STRIP ============================ -->

<!-- Recent Customers -->
<Pane layoutX="40.0" layoutY="524.0" prefHeight="236.0" prefWidth="360.0" style="-fx-background-color: #F8FFF4; -fx-background-radius: 16;">
<children>
<Label layoutX="20.0" layoutY="16.0" text="Recent Customers" textFill="#011936">
<font>
<Font name="Roboto Bold" size="16.0" />
</font>
</Label>
<ListView fx:id="recentCustomersList" layoutX="20.0" layoutY="56.0" prefHeight="160.0" prefWidth="320.0" style="-fx-background-color: white; -fx-border-color: #D6D4E3; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;" />
</children>
</Pane>

<!-- Recent Loans -->
<Pane layoutX="420.0" layoutY="524.0" prefHeight="236.0" prefWidth="360.0" style="-fx-background-color: #F8FFF4; -fx-background-radius: 16;">
<children>
<Label layoutX="20.0" layoutY="16.0" text="Recent Loans" textFill="#011936">
<font>
<Font name="Roboto Bold" size="16.0" />
</font>
</Label>
<ListView fx:id="recentLoansList" layoutX="20.0" layoutY="56.0" prefHeight="160.0" prefWidth="320.0" style="-fx-background-color: white; -fx-border-color: #D6D4E3; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 0; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;" />
</children>
</Pane>

<!-- Loan Summary -->
<Pane layoutX="800.0" layoutY="524.0" prefHeight="236.0" prefWidth="360.0" style="-fx-background-color: #F8FFF4; -fx-background-radius: 16;">
<children>
<Label layoutX="20.0" layoutY="16.0" text="Loan Summary" textFill="#011936">
<font>
<Font name="Roboto Bold" size="16.0" />
</font>
</Label>

<!-- Total loans -->
<Pane layoutX="20.0" layoutY="56.0" prefHeight="84.0" prefWidth="100.0" style="-fx-background-color: #011936; -fx-background-radius: 12;">
<children>
<Label fx:id="summaryTotalLabel" alignment="CENTER" layoutY="8.0" prefHeight="36.0" prefWidth="100.0" text="-" textFill="#F8FFF4">
<font>
<Font name="Roboto Black" size="28.0" />
</font>
</Label>
<Label alignment="CENTER" layoutY="46.0" prefHeight="30.0" prefWidth="100.0" text="TOTAL LOANS" textAlignment="CENTER" textFill="#F8FFF4" wrapText="true">
<font>
<Font name="Roboto Bold" size="10.0" />
</font>
</Label>
</children>
</Pane>

<!-- Awaiting verification -->
<Pane layoutX="130.0" layoutY="56.0" prefHeight="84.0" prefWidth="100.0" style="-fx-background-color: #F18F01; -fx-background-radius: 12;">
<children>
<Label fx:id="summaryAwaitingLabel" alignment="CENTER" layoutY="8.0" prefHeight="36.0" prefWidth="100.0" text="-" textFill="#011936">
<font>
<Font name="Roboto Black" size="28.0" />
</font>
</Label>
<Label alignment="CENTER" layoutY="46.0" prefHeight="30.0" prefWidth="100.0" text="AWAITING VERIFICATION" textAlignment="CENTER" textFill="#011936" wrapText="true">
<font>
<Font name="Roboto Bold" size="10.0" />
</font>
</Label>
</children>
</Pane>

<!-- Incomplete information -->
<Pane layoutX="240.0" layoutY="56.0" prefHeight="84.0" prefWidth="100.0" style="-fx-background-color: #931621; -fx-background-radius: 12;">
<children>
<Label fx:id="summaryIncompleteLabel" alignment="CENTER" layoutY="8.0" prefHeight="36.0" prefWidth="100.0" text="-" textFill="#F8FFF4">
<font>
<Font name="Roboto Black" size="28.0" />
</font>
</Label>
<Label alignment="CENTER" layoutY="46.0" prefHeight="30.0" prefWidth="100.0" text="INCOMPLETE INFO" textAlignment="CENTER" textFill="#F8FFF4" wrapText="true">
<font>
<Font name="Roboto Bold" size="10.0" />
</font>
</Label>
</children>
</Pane>

<Label layoutX="20.0" layoutY="154.0" text="BY STATUS" textFill="#726E97">
<font>
<Font name="Roboto Bold" size="11.0" />
</font>
</Label>
<Label fx:id="summaryStatusLabel" layoutX="20.0" layoutY="174.0" prefHeight="44.0" prefWidth="320.0" text="-" textFill="#011936" wrapText="true" alignment="TOP_LEFT">
<font>
<Font name="Roboto" size="13.0" />
</font>
</Label>
</children>
</Pane>

</children>
</Pane>
