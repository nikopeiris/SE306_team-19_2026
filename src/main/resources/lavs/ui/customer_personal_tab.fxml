<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Text?>

<Pane prefHeight="595.0" prefWidth="1057.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.PersonalInfoController">
   <children>
      <Text layoutX="13.0" layoutY="47.0" strokeType="OUTSIDE" strokeWidth="0.0" text="First Name" />
      <TextField fx:id="firstNameField" layoutX="13.0" layoutY="51.0" />
      
      <Text layoutX="13.0" layoutY="89.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Last Name" />
      <TextField fx:id="lastNameField" layoutX="13.0" layoutY="93.0" />
      
      <Text layoutX="13.0" layoutY="141.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Date Of Birth" />
      <DatePicker fx:id="dateOfBirthField" layoutX="13.0" layoutY="145.0" prefWidth="150.0" />
      
      <Text layoutX="13.0" layoutY="194.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Employer" />
      <ComboBox fx:id="employerField" layoutX="13.0" layoutY="203.0" prefWidth="150.0" />
      
      <Text layoutX="13.0" layoutY="246.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nationality" />
      <ComboBox fx:id="nationalityField" layoutX="13.0" layoutY="250.0" prefWidth="150.0" />
      
      <!-- Title ComboBox -->
      <Text layoutX="13.0" layoutY="300.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Title" />
      <ComboBox fx:id="titleField" layoutX="13.0" layoutY="304.0" prefWidth="150.0" />

      <!-- Status ComboBox -->
      <Text layoutX="13.0" layoutY="353.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Status" />
      <ComboBox fx:id="statusField" layoutX="13.0" layoutY="357.0" prefWidth="150.0" />
      
      <!-- Customer ID -->
      <Text layoutX="13.0" layoutY="406.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Customer ID" />
      <TextField fx:id="customerIdField" layoutX="13.0" layoutY="410.0" />

      <!-- Employment details -->
      <Text layoutX="194.0" layoutY="195.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Job Title" />
      <TextField fx:id="jobTitleField" layoutX="194.0" layoutY="199.0" />

      <Text layoutX="370.0" layoutY="195.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Company" />
      <TextField fx:id="companyField" layoutX="370.0" layoutY="199.0" prefWidth="130.0" />

      <Text layoutX="515.0" layoutY="195.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Start date" />
      <DatePicker fx:id="startDateField" layoutX="515.0" layoutY="199.0" prefWidth="130.0" />

      <Text layoutX="660.0" layoutY="195.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Salary" />
      <TextField fx:id="salaryField" layoutX="660.0" layoutY="199.0" prefWidth="90.0" />

      <Button fx:id="addSecondaryEmploymentButton" layoutX="765.0" layoutY="198.0" mnemonicParsing="false" onAction="#handleAddSecondaryEmployment" text="Add Secondary" />

      <!-- Secondary Employment Pane -->
      <Pane fx:id="secondaryEmploymentPane" layoutX="185.0" layoutY="245.0" prefHeight="50.0" prefWidth="850.0" visible="false" managed="false">
         <children>
            <TextField fx:id="secondaryJobTitleField" layoutX="9.0" layoutY="4.0" prefWidth="120.0" promptText="Job Title" />
            <TextField fx:id="secondaryCompanyField" layoutX="135.0" layoutY="4.0" prefWidth="120.0" promptText="Company" />
            <DatePicker fx:id="secondaryStartDateField" layoutX="260.0" layoutY="4.0" prefWidth="140.0" promptText="Start Date" />
            <TextField fx:id="secondarySalaryField" layoutX="405.0" layoutY="4.0" prefWidth="100.0" promptText="Salary" />
            <Button fx:id="removeSecondaryEmploymentButton" layoutX="515.0" layoutY="4.0" mnemonicParsing="false" onAction="#handleRemoveSecondaryEmployment" text="Remove" textFill="RED" />
         </children>
      </Pane>

      <!-- Form actions -->
      <Button fx:id="personalCancelButton" layoutX="805.0" layoutY="539.0" mnemonicParsing="false" prefHeight="36.0" prefWidth="110.0" text="Cancel">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button fx:id="personalNextButton" defaultButton="true" layoutX="925.0" layoutY="539.0" mnemonicParsing="false" onAction="#handlePersonalInfoNext" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #011936;" text="Next" textFill="WHITE">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</Pane>