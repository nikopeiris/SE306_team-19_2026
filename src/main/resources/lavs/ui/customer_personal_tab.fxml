<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="595.0" prefWidth="1057.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lavs.ui.PersonalInfoController">
   <children>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="20.0">
               <padding>
                  <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
               </padding>
               <children>
                  <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Personal Details" />

                  <GridPane hgap="16.0" vgap="12.0">
                     <columnConstraints>
                        <ColumnConstraints minWidth="110.0" prefWidth="110.0" />
                        <ColumnConstraints minWidth="220.0" prefWidth="260.0" />
                        <ColumnConstraints minWidth="110.0" prefWidth="110.0" />
                        <ColumnConstraints minWidth="220.0" prefWidth="260.0" />
                     </columnConstraints>
                     <children>
                        <Label text="Customer ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="customerIdField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Status" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="statusField" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Title" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox fx:id="titleField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Date of Birth" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <DatePicker fx:id="dateOfBirthField" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Label text="First Name" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="firstNameField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Last Name" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <TextField fx:id="lastNameField" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                        <Label text="Nationality" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <ComboBox fx:id="nationalityField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label text="Employment" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                        <ComboBox fx:id="employerField" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                     </children>
                  </GridPane>

                  <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Employment" />

                  <GridPane hgap="16.0" vgap="12.0">
                     <columnConstraints>
                        <ColumnConstraints minWidth="110.0" prefWidth="110.0" />
                        <ColumnConstraints minWidth="220.0" prefWidth="260.0" />
                        <ColumnConstraints minWidth="110.0" prefWidth="110.0" />
                        <ColumnConstraints minWidth="220.0" prefWidth="260.0" />
                     </columnConstraints>
                     <children>
                        <Label text="Job Title" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="jobTitleField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Company" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="companyField" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Salary" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="salaryField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Button fx:id="addSecondaryEmploymentButton" mnemonicParsing="false" onAction="#handleAddSecondaryEmployment" text="Add Secondary Employment" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                     </children>
                  </GridPane>

                  <HBox fx:id="secondaryEmploymentPane" alignment="CENTER_LEFT" managed="false" spacing="12.0" visible="false">
                     <children>
                        <Label minWidth="110.0" text="Secondary" />
                        <TextField fx:id="secondaryJobTitleField" prefWidth="170.0" promptText="Job Title" />
                        <TextField fx:id="secondaryCompanyField" prefWidth="170.0" promptText="Company" />
                        <TextField fx:id="secondarySalaryField" prefWidth="110.0" promptText="Salary" />
                        <Button mnemonicParsing="false" onAction="#handleRemoveSecondaryEmployment" style="-fx-text-fill: red;" text="Remove" />
                     </children>
                  </HBox>

                  <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Documents" />

                  <HBox alignment="CENTER_LEFT" spacing="16.0">
                     <children>
                        <Button fx:id="documentsButton" mnemonicParsing="false" onAction="#handleDocuments" prefHeight="36.0" prefWidth="170.0" text="View Documents">
                           <cursor><Cursor fx:constant="HAND" /></cursor>
                        </Button>
                        <Label fx:id="documentsHintLabel" style="-fx-text-fill: #726e97;" text="Save the customer first to manage their documents." />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <padding>
            <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#handlePersonalInfoCancel" prefHeight="36.0" prefWidth="110.0" text="Cancel">
               <cursor><Cursor fx:constant="HAND" /></cursor>
            </Button>
            <Button mnemonicParsing="false" onAction="#handlePersonalInfoSave" prefHeight="36.0" prefWidth="110.0" text="Save">
               <cursor><Cursor fx:constant="HAND" /></cursor>
            </Button>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handlePersonalInfoNext" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #011936;" text="Next" textFill="WHITE">
               <cursor><Cursor fx:constant="HAND" /></cursor>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
