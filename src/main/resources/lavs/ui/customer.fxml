         <font>
            <Font name="Roboto Bold" size="16.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Rectangle fx:id="card" arcHeight="50.0" arcWidth="50.0" fill="#f8fff4" height="654.0" layoutX="75.0" layoutY="87.0" stroke="BLACK" strokeType="INSIDE" width="1057.0" />
      <ButtonBar fx:id="topButtonBar" prefHeight="40.0" prefWidth="200.0" />

      <!-- Section tab buttons -->
      <Button fx:id="personalInfoTabButton" layoutX="75.0" layoutY="87.0" mnemonicParsing="false" onAction="#handlePersonalInfoTab" prefHeight="59.0" prefWidth="352.0" text="Personal Info" />
      <Button fx:id="contactInfoTabButton" layoutX="427.0" layoutY="87.0" mnemonicParsing="false" onAction="#handleContactInfoTab" prefHeight="59.0" prefWidth="352.0" text="Contact Info" />
