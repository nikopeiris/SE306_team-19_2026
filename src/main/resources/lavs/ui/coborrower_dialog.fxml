<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox prefWidth="440.0" spacing="14.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.CoborrowerDialog">
   <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
   <children>
      <Label style="-fx-text-fill: #726e97;" wrapText="true"
             text="Search for the customer by first or family name (whole words), pick them from the results, or type their customer number." />
      <HBox spacing="8.0">
         <children>
            <TextField fx:id="searchField" onAction="#handleSearch" promptText="e.g. jane smith" HBox.hgrow="ALWAYS" />
            <Button fx:id="searchButton" onAction="#handleSearch" text="Search" />
         </children>
      </HBox>
      <Label fx:id="searchStatusLabel" maxWidth="Infinity" style="-fx-text-fill: #726e97;" wrapText="true" />
      <ListView fx:id="resultsList" prefHeight="110.0" />
      <GridPane hgap="12.0" vgap="10.0">
         <children>
            <Label text="Customer number *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="customerNumberField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Role *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="typeCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         </children>
      </GridPane>
      <Label fx:id="errorLabel" maxWidth="400.0" style="-fx-text-fill: #b00020;" wrapText="true" />
      <HBox spacing="10.0">
         <children>
            <Button fx:id="saveButton" defaultButton="true" onAction="#handleSave" text="Save" />
            <Button cancelButton="true" onAction="#handleCancel" text="Cancel" />
         </children>
      </HBox>
   </children>
</VBox>
